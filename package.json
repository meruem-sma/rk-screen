{
  "name": "rk-screen",
  "version": "1.0.0-beta.1",
  "rkScreenBuild": "20261016.3",
  "description": "RK Screen - Ekran Paylaşımı ve Uzaktan Destek",
  "main": "src/main.js",
  "author": {
    "name": "RK Softworks",
    "email": "rksoftworks@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "node scripts/build.cjs && node scripts/check-package.cjs && npm run sign && node scripts/finalize-release.cjs",
    "dist:setup": "node scripts/build.cjs nsis && node scripts/check-package.cjs && npm run sign && node scripts/finalize-release.cjs",
    "dist:setup:beta": "node scripts/build.cjs nsis --unsigned-beta && node scripts/check-package.cjs --unsigned-beta",
    "sign": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign.ps1",
    "format": "prettier --write index.html src scripts package.json README.md",
    "check:package": "node scripts/check-package.cjs",
    "release": "npm run check:signing && npm run check:source && npm run dist",
    "release:beta": "npm run check:source && npm run dist:setup:beta",
    "check:signing": "node scripts/signing-config.cjs",
    "licenses:refresh": "node scripts/third-party-notices.cjs",
    "check:source": "node scripts/check-source.cjs"
  },
  "build": {
    "appId": "com.rksoftworks.menzil",
    "productName": "RK Screen",
    "copyright": "Copyright © 2026 RK Softworks. Tüm hakları saklıdır.",
    "directories": {
      "output": "dist/1.0.0-beta.1"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/rk-screen.ico",
      "legalTrademarks": "RK Softworks",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": "RK Softworks"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RK Screen",
      "artifactName": "RK-Screen-Setup-${version}.${ext}",
      "uninstallDisplayName": "RK Screen"
    },
    "files": [
      "package.json",
      "index.html",
      "src/**/*.js",
      "src/**/*.css",
      "assets/rk-screen.ico",
      "assets/rk-screen-mark.png",
      "src/cursor-overlay.html",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**/*"
    ]
  },
  "license": "MIT",
  "homepage": "https://rkscreen.com.tr/",
  "repository": {
    "type": "git",
    "url": "https://github.com/meruem-sma/rk-screen.git"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "global-agent": "4.1.3"
  }
}
